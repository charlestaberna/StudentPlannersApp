<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows plain HTTP (not just HTTPS) so you can test against a local
  XAMPP server (e.g. http://192.168.x.x/...) while developing.
  Once you're pointed at your final https:// InfinityFree URL, you can
  remove the cleartext line below and the usesCleartextTraffic flag in
  AndroidManifest.xml for a more locked-down release build.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
