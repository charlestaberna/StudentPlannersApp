rules_version = '2';

// This app uses its own username/password screens (not Firebase Auth
// popups). Every visitor is quietly signed in anonymously in the
// background so Firestore can tell "someone using the app" apart from
// "a random stranger on the internet". Role checks (admin/faculty/
// student) still happen inside app.js, the same way they did before.
//
// NOTE: because this is a pure front-end (no server), a technically
// determined user could still open devtools and write directly to
// Firestore. For a school project this matches the trust level of the
// original localStorage version. If you need real server-enforced
// security later, that requires a backend (e.g. Cloud Functions) that
// checks roles before writing.

service cloud.firestore {
  match /databases/{database}/documents {
    match /planner/main {
      allow read, write: if request.auth != null;
    }
  }
}
